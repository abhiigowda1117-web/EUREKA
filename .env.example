# Copy to .env.local and fill in. NEVER commit .env.local.
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (older projects call it the "anon" key). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Your site's public URL (http://localhost:3000 locally, https://your-domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Do NOT add the service-role/secret key here. The app doesn't need it.
